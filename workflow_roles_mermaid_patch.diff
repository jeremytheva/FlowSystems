+"use client";
+
+import { useEffect, useState } from "react";
+import type { WorkflowWithStructure } from "@/lib/workflows/types";
+
+interface Props {
+  open: boolean;
+  onClose: () => void;
+  workflow: WorkflowWithStructure;
+}
+
+function sanitizeId(id: string): string {
+  return id.replace(/[^a-zA-Z0-9]/g, "_");
+}
+
+function escapeLabel(s: string): string {
+  return s.replace(/"/g, '\\"').replace(/\n/g, '\\n');
+}
+
+function exportToMermaid(workflow: WorkflowWithStructure): string {
+  const lines: string[] = [];
+  lines.push("graph TD");
+  const roleGroups: Record<string, WorkflowWithStructure["nodes"]> = {};
+  workflow.nodes.forEach((node) => {
+    const role = node.metadata.role || "Unassigned";
+    if (!roleGroups[role]) roleGroups[role] = [];
+    roleGroups[role].push(node);
+  });
+  Object.keys(roleGroups).forEach((role) => {
+    const safeRole = sanitizeId(role);
+    lines.push(`  subgraph ${safeRole}`);
+    roleGroups[role].forEach((node) => {
+      const id = sanitizeId(node.id);
+      const label = escapeLabel(`${node.label}\\n${node.metadata.responsibility || ""}`);
+      lines.push(`    ${id}[\"${label}\"]`);
+    });
+    lines.push("  end");
+  });
+  workflow.edges.forEach((edge) => {
+    const from = sanitizeId(edge.source_node_id);
+    const to = sanitizeId(edge.target_node_id);
+    let label = "";
+    if (edge.trigger) label = edge.trigger;
+    if (edge.action) label = label ? `${label} / ${edge.action}` : edge.action;
+    else if (edge.label) label = edge.label || "";
+    if (label) {
+      lines.push(`  ${from} -->|${label}| ${to}`);
+    } else {
+      lines.push(`  ${from} --> ${to}`);
+    }
+  });
+  return lines.join("\n");
+}
+
+export function MermaidExportModal({ open, onClose, workflow }: Props) {
+  const [code, setCode] = useState("");
+  useEffect(() => {
+    if (open) {
+      setCode(exportToMermaid(workflow));
+    }
+  }, [open, workflow]);
+  if (!open) return null;
+  const handleCopy = async () => {
+    try {
+      await navigator.clipboard.writeText(code);
+    } catch (err) {
+      console.error(err);
+    }
+  };
+  return (
+    <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/30">
+      <div className="w-full max-w-xl rounded-lg bg-white p-6 shadow-xl space-y-4">
+        <div className="flex justify-between items-center">
+          <h3 className="text-lg font-semibold">Mermaid export</h3>
+          <button onClick={onClose} className="text-sm text-gray-500">Close</button>
+        </div>
+        <pre className="overflow-auto bg-gray-100 p-3 rounded-md text-xs" style={{ maxHeight: '400px' }}>
+{code}
+        </pre>
+        <div className="flex justify-end gap-3">
+          <button
+            onClick={handleCopy}
+            className="rounded-md bg-green-600 px-4 py-2 text-sm font-semibold text-white shadow"
+          >
+            Copy to clipboard
+          </button>
+        </div>
+      </div>
+    </div>
+  );
+}
